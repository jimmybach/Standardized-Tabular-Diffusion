{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/snapshot-manifest/1.0.0",
  "title": "Leaderboard Snapshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_manifest_schema_version", "snapshot_id", "snapshot_fingerprint", "finalization_status", "files", "checksum_algorithm"],
  "properties": {
    "snapshot_manifest_schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "snapshot_fingerprint": {"$ref": "#/$defs/sha256"},
    "finalization_status": {"enum": ["incomplete", "finalized"]},
    "files": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "byte_size"],
        "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_size": {"type": "integer", "minimum": 0}}
      }
    },
    "checksum_algorithm": {"const": "sha256"}
  },
  "allOf": [{"if": {"properties": {"finalization_status": {"const": "finalized"}}}, "then": {"properties": {"files": {"minItems": 4, "maxItems": 4}}}}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*[<>:|?*])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
  }
}
