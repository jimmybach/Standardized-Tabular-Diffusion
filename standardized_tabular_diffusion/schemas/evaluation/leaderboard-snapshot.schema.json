{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/leaderboard-snapshot/1.0.0",
  "title": "Leaderboard Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["leaderboard_snapshot_schema_version", "snapshot_id", "snapshot_fingerprint", "input_fingerprint", "request", "published_at", "repository_release", "publication_class", "comparison_track", "protocol", "dataset_suite", "metric", "aggregation", "bootstrap", "ties", "input_bundles", "dataset_summaries", "leaderboard", "pairwise_completeness", "corrections", "admissions", "publication_assets", "claim_boundary"],
  "properties": {
    "leaderboard_snapshot_schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "snapshot_fingerprint": {"$ref": "#/$defs/sha256"},
    "input_fingerprint": {"$ref": "#/$defs/sha256"},
    "request": {"type": "object"},
    "published_at": {"type": "string", "format": "date-time"},
    "repository_release": {"$ref": "#/$defs/id"},
    "publication_class": {"enum": ["official", "partial-diagnostic", "community"]},
    "comparison_track": {"enum": ["native", "standardized-tuning"]},
    "protocol": {"type": "object"},
    "dataset_suite": {"type": "object"},
    "metric": {"type": "object"},
    "aggregation": {"type": "object"},
    "bootstrap": {"type": "object"},
    "ties": {"type": "object"},
    "input_bundles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/run"}},
    "dataset_summaries": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "leaderboard": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "pairwise_completeness": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pair"}},
    "corrections": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "admissions": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "publication_assets": {
      "type": "array",
      "prefixItems": [
        {"const": "leaderboard.json"},
        {"const": "leaderboard.csv"},
        {"const": "leaderboard.html"},
        {"const": "leaderboard.md"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_counts": {
      "type": "object",
      "propertyNames": {"enum": ["computed", "not_applicable", "mathematically_undefined", "insufficient_support", "implementation_failure", "resource_failure", "missing"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "request_fingerprint", "manifest_sha256", "model_id", "dataset_id", "generation_seed", "compatibility_key", "state_counts", "score", "score_reason"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/id"},
        "request_fingerprint": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "model_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"},
        "generation_seed": {"type": "integer"},
        "compatibility_key": {"$ref": "#/$defs/sha256"},
        "state_counts": {"$ref": "#/$defs/state_counts"},
        "score": {"type": ["number", "null"]},
        "score_reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence_level", "lower", "upper", "replicates", "random_seed"],
      "properties": {
        "method": {"const": "hierarchical-percentile"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "replicates": {"type": "integer", "minimum": 100},
        "random_seed": {"type": "integer"}
      }
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "computed", "fraction"],
      "properties": {
        "expected": {"type": "integer", "minimum": 1},
        "computed": {"type": "integer", "minimum": 0},
        "fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "score", "uncertainty", "dataset_coverage", "seed_coverage", "official_eligible", "official_reason_codes", "rank", "diagnostic_order", "tie_group"],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"},
        "score": {"type": ["number", "null"]},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "dataset_coverage": {"$ref": "#/$defs/fraction"},
        "seed_coverage": {"$ref": "#/$defs/fraction"},
        "official_eligible": {"type": "boolean"},
        "official_reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "diagnostic_order": {"type": ["integer", "null"], "minimum": 1},
        "tie_group": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_a", "model_b", "expected_paired_cells", "observed_paired_cells", "pairwise_completeness", "mean_raw_difference_a_minus_b", "superiority_claim", "multiple_comparison_correction"],
      "properties": {
        "model_a": {"$ref": "#/$defs/id"},
        "model_b": {"$ref": "#/$defs/id"},
        "expected_paired_cells": {"type": "integer", "minimum": 1},
        "observed_paired_cells": {"type": "integer", "minimum": 0},
        "pairwise_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_raw_difference_a_minus_b": {"type": ["number", "null"]},
        "superiority_claim": {"const": "not-issued"},
        "multiple_comparison_correction": {"const": "not-applicable-without-superiority-claims"}
      }
    }
  }
}
