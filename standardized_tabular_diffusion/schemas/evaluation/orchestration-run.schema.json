{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/orchestration-run/1.0.0",
  "title": "Orchestration Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orchestration_run_schema_version", "run_id", "invocation_id", "previous_invocation_id", "status",
    "started_at", "ended_at", "config_fingerprint", "code_fingerprint", "software_fingerprint",
    "software_profile_ref", "hardware_profile_ref", "hardware_comparison_key", "cache_policy", "stage_records", "current_stage_ids",
    "failed_required_stages", "failed_optional_stages", "resume_ancestry", "warning_codes"
  ],
  "properties": {
    "orchestration_run_schema_version": {"const": "1.0.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "invocation_id": {"$ref": "#/$defs/id"},
    "previous_invocation_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "status": {"enum": ["running", "success", "partial", "failed", "cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "config_fingerprint": {"$ref": "#/$defs/sha256"},
    "code_fingerprint": {"$ref": "#/$defs/sha256"},
    "software_fingerprint": {"$ref": "#/$defs/sha256"},
    "software_profile_ref": {"$ref": "#/$defs/path"},
    "hardware_profile_ref": {"$ref": "#/$defs/path"},
    "hardware_comparison_key": {"$ref": "#/$defs/sha256"},
    "cache_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "content_addressed", "artifact_verification", "cache_location_class"],
      "properties": {
        "enabled": {"type": "boolean"}, "content_addressed": {"const": true},
        "artifact_verification": {"const": "sha256-and-size"},
        "cache_location_class": {"enum": ["run-local", "external"]}
      }
    },
    "stage_records": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage_id", "stage_name", "status", "identity_fingerprint", "path"],
        "properties": {
          "stage_id": {"$ref": "#/$defs/id"}, "stage_name": {"$ref": "#/$defs/id"},
          "status": {"enum": ["running", "succeeded", "failed", "skipped", "cancelled", "invalidated"]},
          "identity_fingerprint": {"$ref": "#/$defs/sha256"}, "path": {"$ref": "#/$defs/path"}
        }
      }
    },
    "current_stage_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "failed_required_stages": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "failed_optional_stages": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "resume_ancestry": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "warning_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "running"}}}, "then": {"properties": {"ended_at": {"type": "null"}}}},
    {"if": {"properties": {"status": {"enum": ["success", "partial", "failed", "cancelled"]}}}, "then": {"properties": {"ended_at": {"type": "string", "format": "date-time"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*[<>:|?*])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
  }
}
