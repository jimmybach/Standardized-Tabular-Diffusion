{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/dataset-profile/1.0.0",
  "title": "Dataset Profile",
  "type": "object", "additionalProperties": false,
  "required": ["profile_schema_version", "dataset_profile_version", "dataset_id", "display_name", "dataset_version", "dataset_view", "dataset_family", "status", "owners", "review_record", "change_log", "suite_membership", "official_eligible", "source_rights", "table_contract", "columns", "preprocessing", "views", "split", "predictive_tasks", "validity", "privacy", "metric_applicability"],
  "properties": {
    "profile_schema_version": {"const": "1.0.0"}, "dataset_profile_version": {"$ref": "#/$defs/id"}, "dataset_id": {"$ref": "#/$defs/id"}, "display_name": {"type": "string", "minLength": 1},
    "dataset_version": {"$ref": "#/$defs/id"}, "dataset_view": {"$ref": "#/$defs/id"}, "dataset_family": {"$ref": "#/$defs/id"}, "status": {"enum": ["draft", "reviewed", "frozen", "deprecated", "legacy-imported"]},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "review_record": {"type": "object"}, "change_log": {"type": "array", "items": {"type": "object"}},
    "suite_membership": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["universal-core", "extended-catalog", "diagnostic"]}}, "official_eligible": {"type": "boolean"},
    "source_rights": {"type": "object", "additionalProperties": false, "required": ["canonical_source", "publisher", "source_version", "retrieved_date", "raw_files", "citation", "license", "access_restrictions", "permitted_uses", "redistribution_status", "modification_requirements", "attribution_requirements", "rights_review"], "properties": {"canonical_source": {"type": "string"}, "publisher": {"type": "string"}, "source_version": {"type": "string"}, "retrieved_date": {"type": ["string", "null"], "format": "date"}, "raw_files": {"type": "array", "items": {"type": "object"}}, "citation": {"type": "string"}, "license": {"type": "string"}, "access_restrictions": {"type": "array", "items": {"type": "string"}}, "permitted_uses": {"type": "array", "items": {"type": "string"}}, "redistribution_status": {"enum": ["permitted", "metadata-only", "download-script-only", "restricted", "prohibited", "unknown"]}, "modification_requirements": {"type": "array", "items": {"type": "string"}}, "attribution_requirements": {"type": "array", "items": {"type": "string"}}, "rights_review": {"type": "object"}}},
    "table_contract": {"type": "object"},
    "columns": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "column_id", "semantic_type", "storage_type", "roles", "nullable_raw", "nullable_model_input", "valid_domain", "category_vocabulary_source", "transformation_policy", "inverse_transformation_policy", "description", "unit", "sensitivity", "constraint_refs"], "properties": {"name": {"type": "string"}, "column_id": {"$ref": "#/$defs/id"}, "semantic_type": {"enum": ["continuous", "integer", "categorical", "boolean", "datetime", "string"]}, "storage_type": {"type": "string"}, "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["feature", "primary_target", "secondary_target", "identifier", "sensitive_attribute", "quasi_identifier", "group_attribute", "ignored", "audit_only"]}}, "nullable_raw": {"type": "boolean"}, "nullable_model_input": {"type": "boolean"}, "valid_domain": {"type": ["object", "null"]}, "category_vocabulary_source": {"type": ["string", "null"]}, "transformation_policy": {"type": "string"}, "inverse_transformation_policy": {"type": "string"}, "description": {"type": "string"}, "unit": {"type": ["string", "null"]}, "sensitivity": {"type": "object"}, "constraint_refs": {"type": "array", "items": {"type": "string"}}}}},
    "preprocessing": {"type": "object"}, "views": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "split": {"type": "object"}, "predictive_tasks": {"type": "array", "items": {"type": "object"}},
    "utility": {"$ref": "#/$defs/p4Utility"},
    "validity": {"oneOf": [{"$ref": "#/$defs/p3Validity"}, {"type": "object", "not": {"required": ["contract_schema_version"]}}]},
    "privacy": {"type": "object"}, "metric_applicability": {"type": "object"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "legacy-imported"}}}, "then": {"properties": {"official_eligible": {"const": false}}}}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source_type", "reference"],
      "properties": {
        "source_type": {"enum": ["authoritative-data-dictionary", "dataset-documentation", "legal-or-policy-requirement", "recorded-human-review"]},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "column_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "semantic_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["continuous", "integer", "categorical", "boolean", "datetime", "string"]}},
        "nullable_model_input": {"type": "boolean"},
        "roles_any": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "valid_domain_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "hardColumnRule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "rule_type", "selector", "parameters", "evidence", "severity", "version"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "rule_type": {"enum": ["not_null", "finite", "integer", "allowed_values", "bounds", "regex", "length", "unique", "datetime_range"]},
        "selector": {"$ref": "#/$defs/selector"},
        "parameters": {"type": "object"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "severity": {"const": "hard"},
        "version": {"const": "1.0.0"}
      }
    },
    "crossColumnConstraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "constraint_type", "columns", "parameters", "applicability", "missing_behavior", "evidence", "severity", "version"],
      "properties": {
        "constraint_id": {"$ref": "#/$defs/id"},
        "constraint_type": {"enum": ["comparison", "conditional_domain", "mutual_exclusion", "sum_equals", "allowed_combinations", "functional_dependency"]},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "parameters": {"type": "object"},
        "applicability": {"type": "object"},
        "missing_behavior": {"enum": ["violation", "not_applicable"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "severity": {"const": "hard"},
        "version": {"const": "1.0.0"}
      }
    },
    "p3Validity": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_schema_version", "status", "hard_column_rules", "cross_column_constraints", "soft_diagnostics", "unresolved_reviews"],
      "properties": {
        "contract_schema_version": {"const": "1.0.0"},
        "status": {"enum": ["reviewed-diagnostic", "frozen"]},
        "hard_column_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hardColumnRule"}},
        "cross_column_constraints": {"type": "array", "items": {"$ref": "#/$defs/crossColumnConstraint"}},
        "soft_diagnostics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unresolved_reviews": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "p4Utility": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_schema_version", "status", "local", "global"],
      "properties": {
        "contract_schema_version": {"const": "1.0.0"},
        "status": {"enum": ["reviewed-diagnostic", "frozen"]},
        "local": {
          "type": "object", "additionalProperties": false,
          "required": ["primary_task_id", "evaluator_profile_id", "evaluator_profile_version"],
          "properties": {
            "primary_task_id": {"$ref": "#/$defs/id"},
            "evaluator_profile_id": {"$ref": "#/$defs/id"},
            "evaluator_profile_version": {"$ref": "#/$defs/id"}
          }
        },
        "global": {
          "type": "object", "additionalProperties": false,
          "required": ["included_target_column_ids", "excluded_targets", "evaluator_profile_id", "evaluator_profile_version"],
          "properties": {
            "included_target_column_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "excluded_targets": {
              "type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["column_id", "reason_code", "reason_detail"],
                "properties": {
                  "column_id": {"$ref": "#/$defs/id"},
                  "reason_code": {"$ref": "#/$defs/id"},
                  "reason_detail": {"type": "string", "minLength": 1}
                }
              }
            },
            "evaluator_profile_id": {"$ref": "#/$defs/id"},
            "evaluator_profile_version": {"$ref": "#/$defs/id"}
          }
        }
      }
    }
  }
}
