{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/dataset-summary/1.0.0",
  "title": "Dataset Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_summary_schema_version", "summary_id", "model_id", "dataset", "metric", "comparison_track", "compatibility_key", "expected_seeds", "accepted_runs", "rejected_runs", "seed_results", "aggregate", "uncertainty", "coverage", "state_counts", "official_admission"],
  "properties": {
    "dataset_summary_schema_version": {"const": "1.0.0"},
    "summary_id": {"$ref": "#/$defs/id"},
    "model_id": {"$ref": "#/$defs/id"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "metric": {"$ref": "#/$defs/metric"},
    "comparison_track": {"enum": ["native", "standardized-tuning"]},
    "compatibility_key": {"$ref": "#/$defs/sha256"},
    "expected_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "accepted_runs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/run"}},
    "rejected_runs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/rejected"}},
    "seed_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seed_result"}},
    "aggregate": {"type": ["number", "null"]},
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "state_counts": {"$ref": "#/$defs/state_counts"},
    "official_admission": {"$ref": "#/$defs/admission"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_profile_version", "sha256"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"},
        "dataset_profile_version": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "metric_version", "dimension", "direction"],
      "properties": {
        "metric_id": {"$ref": "#/$defs/id"},
        "metric_version": {"$ref": "#/$defs/id"},
        "dimension": {"$ref": "#/$defs/id"},
        "direction": {"enum": ["maximize", "minimize"]}
      }
    },
    "state_counts": {
      "type": "object",
      "propertyNames": {"enum": ["computed", "not_applicable", "mathematically_undefined", "insufficient_support", "implementation_failure", "resource_failure", "missing"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "request_fingerprint", "manifest_sha256", "model_id", "dataset_id", "generation_seed", "compatibility_key", "state_counts", "score", "score_reason"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/id"},
        "request_fingerprint": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "model_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"},
        "generation_seed": {"type": "integer"},
        "compatibility_key": {"$ref": "#/$defs/sha256"},
        "state_counts": {"$ref": "#/$defs/state_counts"},
        "score": {"type": ["number", "null"]},
        "score_reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "model_id", "dataset_id", "generation_seed", "reason_code", "correction_id", "replacement_bundle_id"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/id"},
        "model_id": {"$ref": "#/$defs/id"},
        "dataset_id": {"$ref": "#/$defs/id"},
        "generation_seed": {"type": "integer"},
        "reason_code": {"$ref": "#/$defs/id"},
        "correction_id": {"$ref": "#/$defs/id"},
        "replacement_bundle_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "seed_result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation_seed", "state", "score", "bundle_id"],
          "properties": {"generation_seed": {"type": "integer"}, "state": {"const": "computed"}, "score": {"type": "number"}, "bundle_id": {"$ref": "#/$defs/id"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation_seed", "state", "score", "bundle_id"],
          "properties": {"generation_seed": {"type": "integer"}, "state": {"const": "missing"}, "score": {"type": "null"}, "bundle_id": {"type": "null"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation_seed", "state", "score", "bundle_id", "reason_code"],
          "properties": {"generation_seed": {"type": "integer"}, "state": {"const": "failed"}, "score": {"type": "null"}, "bundle_id": {"$ref": "#/$defs/id"}, "reason_code": {"$ref": "#/$defs/id"}}
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence_level", "lower", "upper", "replicates", "random_seed"],
      "properties": {
        "method": {"const": "hierarchical-percentile"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "replicates": {"type": "integer", "minimum": 100},
        "random_seed": {"type": "integer"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_seed_count", "computed_seed_count", "failed_seed_count", "missing_seed_count", "fraction", "complete"],
      "properties": {
        "expected_seed_count": {"type": "integer", "minimum": 1},
        "computed_seed_count": {"type": "integer", "minimum": 0},
        "failed_seed_count": {"type": "integer", "minimum": 0},
        "missing_seed_count": {"type": "integer", "minimum": 0},
        "fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "complete": {"type": "boolean"}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "checks", "reason_codes"],
      "properties": {
        "eligible": {"type": "boolean"},
        "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
