{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/legacy-import-record/1.0.0",
  "title": "Legacy Summary Import Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["legacy_import_schema_version", "bundle_type", "classification", "source", "identity", "conversion", "migration_window", "files"],
  "properties": {
    "legacy_import_schema_version": {"const": "1.0.0"},
    "bundle_type": {"const": "legacy-summary-import"},
    "classification": {"const": "legacy-diagnostic"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "schema_version", "protocol_name", "sha256", "byte_size"],
      "properties": {
        "format": {"const": "standardized_summary.json"},
        "schema_version": {"const": "1.0"},
        "protocol_name": {"const": "tabstruct-aligned-v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "dataset"],
      "properties": {"model": {"type": "string", "minLength": 1}, "dataset": {"type": "string", "minLength": 1}}
    },
    "conversion": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "atomic_evidence_available", "official_results_allowed", "lossy_fields", "reason_code"],
      "properties": {
        "status": {"const": "not-converted"},
        "atomic_evidence_available": {"const": false},
        "official_results_allowed": {"const": false},
        "lossy_fields": {"type": "array", "maxItems": 0},
        "reason_code": {"const": "legacy-summary-has-no-atomic-evidence"}
      }
    },
    "migration_window": {
      "type": "object", "additionalProperties": false,
      "required": ["supported_release_line", "removal_not_before"],
      "properties": {
        "supported_release_line": {"const": "0.1.x"},
        "removal_not_before": {"const": "0.2.0"}
      }
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "byte_size"],
        "properties": {
          "path": {"const": "source/standardized_summary.json"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "byte_size": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
