{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/manifest/1.0.0",
  "title": "Result Bundle Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["manifest_schema_version", "bundle_id", "bundle_type", "bundle_schema_version", "created_at", "finalized_at", "finalization_status", "identity", "files", "external_artifacts", "supersedes", "invalidates", "producer", "checksum_algorithm"],
  "properties": {
    "manifest_schema_version": {"const": "1.0.0"}, "bundle_id": {"$ref": "#/$defs/id"}, "bundle_type": {"enum": ["run-result", "dataset-summary", "model-submission"]}, "bundle_schema_version": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"}, "finalized_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}, "finalization_status": {"enum": ["incomplete", "finalized", "invalidated", "withdrawn"]},
    "identity": {"type": "object", "additionalProperties": false, "required": ["request_fingerprint", "run_id"], "properties": {"request_fingerprint": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/id"}}},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "required", "status", "media_type", "sha256", "reason_code"], "properties": {"path": {"$ref": "#/$defs/path"}, "required": {"type": "boolean"}, "status": {"enum": ["present", "pending", "not-applicable"]}, "media_type": {"type": "string"}, "sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "reason_code": {"type": ["string", "null"]}}}},
    "external_artifacts": {"type": "array", "items": {"type": "object"}}, "supersedes": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "invalidates": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "dirty"], "properties": {"repository": {"type": "string"}, "commit": {"type": "string"}, "dirty": {"type": "boolean"}}}, "checksum_algorithm": {"const": "sha256"}
  },
  "allOf": [{"if": {"properties": {"finalization_status": {"const": "incomplete"}}}, "then": {"properties": {"finalized_at": {"type": "null"}}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*[<>:|?*])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}}
}
