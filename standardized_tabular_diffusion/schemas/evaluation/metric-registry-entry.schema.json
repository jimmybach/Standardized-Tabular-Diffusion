{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/metric-registry-entry/1.0.0",
  "title": "Metric Registry Entry",
  "type": "object", "additionalProperties": false,
  "required": ["registry_schema_version", "metric_id", "metric_version", "display_name", "dimension", "subdimension", "description", "definition_origin", "planned_leaderboard_role", "owner", "lifecycle_status", "review_record", "source", "semantics", "validation", "lifecycle_evidence", "admission"],
  "properties": {
    "registry_schema_version": {"const": "1.0.0"}, "metric_id": {"$ref": "#/$defs/id"}, "metric_version": {"$ref": "#/$defs/id"},
    "display_name": {"type": "string", "minLength": 1}, "dimension": {"$ref": "#/$defs/id"}, "subdimension": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1},
    "definition_origin": {"enum": ["source-defined", "source-parameterized", "benchmark-derived", "benchmark-native"]},
    "planned_leaderboard_role": {"enum": ["official-component", "diagnostic", "excluded", "legacy-diagnostic"]}, "owner": {"type": "string", "minLength": 1},
    "lifecycle_status": {"enum": ["registered", "definition-reviewed", "implementation-complete", "unit-validated", "source-parity-validated", "protocol-frozen", "release-supported"]},
    "review_record": {"type": "object", "additionalProperties": false, "required": ["registered_by", "registered_at", "reviews"], "properties": {"registered_by": {"type": "string", "minLength": 1}, "registered_at": {"type": "string", "format": "date-time"}, "reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["review_type", "reviewer", "reviewed_at", "decision", "evidence_ref"], "properties": {"review_type": {"type": "string"}, "reviewer": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date-time"}, "decision": {"enum": ["approved", "rejected", "changes-requested"]}, "evidence_ref": {"type": "string"}}}}}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["method_references", "upstream", "revision", "implementation_symbol", "source_authority", "implementation_mode", "retrieved_date", "integrity_hash", "license", "attribution", "known_deviations"],
      "properties": {
        "method_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "upstream": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
        "implementation_symbol": {"type": "string", "minLength": 1}, "source_authority": {"enum": ["official-package", "official-repository", "approved-patch", "local"]},
        "implementation_mode": {"enum": ["package-wrapper", "source-wrapper", "approved-source-patch", "local-reimplementation", "legacy-import"]}, "retrieved_date": {"type": "string", "format": "date"},
        "integrity_hash": {"type": ["string", "null"]}, "license": {"type": "string", "minLength": 1}, "attribution": {"type": "array", "items": {"type": "string"}}, "known_deviations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["supported_table_types", "supported_column_types", "required_dataset_profile_metadata", "input_view", "fitted_on", "output", "raw_range", "raw_direction", "target_value", "undefined_conditions", "minimum_support", "randomness", "default_parameters", "allowed_overrides", "normalization", "aggregation", "uncertainty", "failure_contribution_policy"],
      "properties": {
        "supported_table_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "supported_column_types": {"type": "array", "items": {"enum": ["continuous", "integer", "categorical", "boolean", "datetime", "string"]}},
        "required_dataset_profile_metadata": {"type": "array", "items": {"type": "string"}}, "input_view": {"type": "string", "minLength": 1}, "fitted_on": {"enum": ["none", "train", "validation", "test", "reference"]},
        "output": {"type": "object", "additionalProperties": false, "required": ["shape", "unit"], "properties": {"shape": {"enum": ["scalar", "distribution", "matrix", "structured"]}, "unit": {"type": ["string", "null"]}}},
        "raw_range": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}}}]},
        "raw_direction": {"enum": ["maximize", "minimize", "target", "distributional", "descriptive"]}, "target_value": {"type": ["number", "null"]},
        "undefined_conditions": {"type": "array", "items": {"type": "string"}}, "minimum_support": {"type": "object"}, "randomness": {"type": "object"}, "default_parameters": {"type": "object"}, "allowed_overrides": {"type": "array", "items": {"type": "string"}},
        "normalization": {"type": "object", "additionalProperties": false, "required": ["function", "version"], "properties": {"function": {"type": "string"}, "version": {"type": "string"}}},
        "aggregation": {"type": "object", "additionalProperties": false, "required": ["rule", "version"], "properties": {"rule": {"type": "string"}, "version": {"type": "string"}}}, "uncertainty": {"type": "object"},
        "failure_contribution_policy": {"type": "object", "additionalProperties": false, "required": ["computed", "mathematically_undefined", "insufficient_support", "not_applicable", "implementation_failure", "resource_failure"], "properties": {"computed": {"type": "string"}, "mathematically_undefined": {"type": "string"}, "insufficient_support": {"type": "string"}, "not_applicable": {"type": "string"}, "implementation_failure": {"type": "string"}, "resource_failure": {"type": "string"}}}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_test_evidence", "boundary_test_evidence", "source_parity_evidence", "numerical_tolerance", "reference_fixtures", "supported_environment", "unresolved_limitations", "release_decision"],
      "properties": {"unit_test_evidence": {"type": "array", "items": {"type": "string"}}, "boundary_test_evidence": {"type": "array", "items": {"type": "string"}}, "source_parity_evidence": {"type": "array", "items": {"type": "string"}}, "numerical_tolerance": {"type": "object"}, "reference_fixtures": {"type": "array", "items": {"type": "string"}}, "supported_environment": {"type": "object"}, "unresolved_limitations": {"type": "array", "items": {"type": "string"}}, "release_decision": {"enum": ["pending", "diagnostic-only", "approved", "rejected"]}}
    },
    "lifecycle_evidence": {"type": "object", "additionalProperties": false, "required": ["definition_review", "implementation", "unit_validation", "source_parity", "protocol_freeze", "release_approval"], "properties": {"definition_review": {"$ref": "#/$defs/nullableEvidence"}, "implementation": {"$ref": "#/$defs/nullableEvidence"}, "unit_validation": {"$ref": "#/$defs/nullableEvidence"}, "source_parity": {"$ref": "#/$defs/nullableEvidence"}, "protocol_freeze": {"$ref": "#/$defs/nullableEvidence"}, "release_approval": {"$ref": "#/$defs/nullableEvidence"}}},
    "admission": {"type": "object", "additionalProperties": false, "required": ["official_results_allowed", "compatibility_version", "reason"], "properties": {"official_results_allowed": {"type": "boolean"}, "compatibility_version": {"type": "string"}, "reason": {"type": "string"}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "nullableEvidence": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["decision", "reviewer", "reviewed_at", "evidence_refs"], "properties": {"decision": {"const": "approved"}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}]}
  }
}
