{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/admission-record/1.0.0",
  "title": "Independent Admission Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["admission_schema_version", "admission_id", "subject_type", "subject_identity", "decision", "publication_classes", "reviewer", "reviewed_at", "evidence_refs", "supersedes"],
  "properties": {
    "admission_schema_version": {"const": "1.0.0"},
    "admission_id": {"$ref": "#/$defs/id"},
    "subject_type": {"enum": ["model", "dataset", "metric", "protocol", "comparison-track", "run", "repository-release", "dataset-suite"]},
    "subject_identity": {"type": "object", "minProperties": 1},
    "decision": {"enum": ["approved", "rejected", "withdrawn"]},
    "publication_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["official", "partial-diagnostic", "community"]}},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"}
  }
}
