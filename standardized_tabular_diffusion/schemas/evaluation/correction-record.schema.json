{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardized-tabular-diffusion.org/schemas/correction-record/1.0.0",
  "title": "Leaderboard Correction Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["correction_schema_version", "correction_id", "action", "affected_bundle_id", "replacement_bundle_id", "reason_code", "reason_detail", "reviewer", "reviewed_at", "evidence_refs"],
  "properties": {
    "correction_schema_version": {"const": "1.0.0"},
    "correction_id": {"$ref": "#/$defs/id"},
    "action": {"enum": ["invalidate", "supersede"]},
    "affected_bundle_id": {"$ref": "#/$defs/id"},
    "replacement_bundle_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "reason_code": {"$ref": "#/$defs/id"},
    "reason_detail": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"}}
}
