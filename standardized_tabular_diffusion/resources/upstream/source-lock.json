          "reason": "The snapshot derives checkpoints from its source module path.",
          "semantic_effect": "The module-local __file__ anchor is redirected to output_dir so the same state_dict files are written outside tracked source; no checkpoint content or algorithm operation changes."
        },
        {
          "classification": "adapter-only",
          "id": "codi-exact-sample-count-v1",
          "reason": "The snapshot always allocates sampling tensors at the training-row count and ignores the shared --num-samples argument.",
          "semantic_effect": "After official transformers are fitted on the complete training data, only the transformed placeholder row dimension is repeated or truncated to the requested count; model weights, learned transforms, categories, and reverse diffusion equations are unchanged."
        }
